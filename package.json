{
  "name": "cf-dnspod-sync",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "check": "tsc --noEmit && node --test tests/*.test.mjs",
    "observe": "node --use-env-proxy run.mjs --observe",
    "plan": "node --use-env-proxy run.mjs --plan",
    "apply": "node --use-env-proxy run.mjs --apply",
    "probe": "node --use-env-proxy probe.mjs",
    "freeze": "node --use-env-proxy scripts/publication.mjs freeze",
    "resume": "node --use-env-proxy scripts/publication.mjs resume",
    "status": "node --use-env-proxy scripts/publication.mjs status",
    "trigger:token": "node --use-env-proxy scripts/publish-trigger-token.mjs",
    "deploy:dry-run": "node --use-env-proxy scripts/deploy.mjs test --dry-run && node --use-env-proxy scripts/deploy.mjs trigger --dry-run",
    "deploy": "node --use-env-proxy scripts/deploy.mjs trigger",
    "deploy:test": "node --use-env-proxy scripts/deploy.mjs test",
    "deploy:all": "npm run deploy && npm run deploy:test",
    "logs": "node scripts/logs.mjs trigger",
    "logs:test": "node scripts/logs.mjs test"
  },
  "devDependencies": { "miniflare": "5.20261006.1-alpha", "typescript": "5.8.3", "wrangler": "4.149.0" },
  "overrides": { "miniflare": { "undici": "7.30.1" } }
}
